@model List<Platform.Web.Models.ViewModels.DepartmanListeViewModel>
@{
    ViewData["Title"] = "Departmanlar";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="sayfa-ust">
  <p class="sayfa-aciklama">Şirketteki departmanları ve her departmandaki aktif personel sayısını buradan görebilirsin.</p>
  <a class="buton buton-birincil" asp-controller="Admin" asp-action="DepartmanEkle">
    <i class="bi bi-plus-lg"></i> Yeni Departman
  </a>
</div>

@if (TempData["Basari"] is string basari)
{
  <div class="uyari uyari-basari">@basari</div>
}
@if (TempData["Bilgi"] is string bilgi)
{
  <div class="uyari uyari-bilgi">@bilgi</div>
}
@if (TempData["Hata"] is string hata)
{
  <div class="uyari uyari-hata">@hata</div>
}

<section class="panel-kutu">
  @if (Model.Count == 0)
  {
    <div class="bos-durum">
      <i class="bi bi-building"></i>
      Henüz departman eklenmemiş.
    </div>
  }
  else
  {
    <div class="tablo-sarici">
      <table class="tablo">
        <thead>
          <tr>
            <th>Departman</th>
            <th class="sayi">Personel sayısı</th>
            <th>Yönetici</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var departman in Model)
          {
            <tr>
              <td>@departman.Ad</td>
              <td class="sayi">@departman.PersonelSayisi</td>
              <td>
                @if (departman.YoneticiAdi is null)
                {
                  <span class="soluk">Atanmadı</span>
                }
                else
                {
                  @departman.YoneticiAdi
                }
              </td>
              <td>
                <a class="tablo-link" asp-controller="Admin" asp-action="DepartmanYoneticisi" asp-route-id="@departman.Id">
                  @if (departman.YoneticiAdi is null)
                  {
                    <i class="bi bi-person-plus"></i> @:Yönetici ata
                  }
                  else
                  {
                    <i class="bi bi-arrow-repeat"></i> @:Yöneticiyi değiştir
                  }
                </a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>
