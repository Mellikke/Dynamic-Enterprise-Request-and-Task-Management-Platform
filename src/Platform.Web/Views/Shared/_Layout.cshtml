<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"] - Platform</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
</head>
<body>

  <!-- Üst bar -->
  <header class="ust-bar">
    <a class="marka" href="#">Platform</a>

    <button type="button" class="menu-btn" id="menuBtn" aria-label="Menüyü aç/kapat">
      <i class="bi bi-list"></i>
    </button>

    <form class="arama" role="search">
      <input type="search" placeholder="Ara...">
      <button type="submit" aria-label="Ara"><i class="bi bi-search"></i></button>
    </form>

    <div class="kullanici">
      <button type="button" class="kullanici-btn" id="kullaniciBtn" aria-label="Kullanıcı menüsü">
        <i class="bi bi-person-circle"></i>
        <i class="bi bi-caret-down-fill"></i>
      </button>
      <div class="kullanici-menu" id="kullaniciMenu">
        <a href="#">Profilim</a>
        <a href="#">Ayarlar</a>
        <hr>
        <a href="/">Çıkış Yap</a>
      </div>
    </div>
  </header>

  <!-- Sol menü -->
  <nav class="yan-menu">
    <div class="menu-baslik">Ana</div>
    <a class="menu-link" href="#"><i class="bi bi-speedometer2"></i> Panel</a>

    <div class="menu-baslik">Görev Yönetimi</div>
    <a class="menu-link" href="#"><i class="bi bi-people"></i> Gruplar</a>
    <a class="menu-link" href="#"><i class="bi bi-list-check"></i> Görevler</a>

    <div class="menu-baslik">Yönetim</div>
    <a class="menu-link" href="#"><i class="bi bi-building"></i> Departmanlar</a>
    <a class="menu-link" href="#"><i class="bi bi-person-badge"></i> Çalışanlar</a>

    <div class="yan-alt">
      Giriş yapan:<br>
      <strong>Admin</strong>
    </div>
  </nav>

  <!-- İçerik -->
  <div class="icerik-alani">
    <main class="icerik">
      <h1 class="sayfa-baslik">@ViewData["Title"]</h1>
      @RenderBody()
    </main>
    <footer class="alt-bilgi">© 2026 Platform</footer>
  </div>

  <script>
    // Sol menüyü aç / kapat
    document.getElementById("menuBtn").addEventListener("click", function () {
      if (window.innerWidth <= 768) {
        document.body.classList.toggle("menu-acik");
      } else {
        document.body.classList.toggle("menu-kapali");
      }
    });

    // Kullanıcı menüsü
    const kullaniciMenu = document.getElementById("kullaniciMenu");
    document.getElementById("kullaniciBtn").addEventListener("click", function (e) {
      e.stopPropagation();
      kullaniciMenu.classList.toggle("acik");
    });
    document.addEventListener("click", function () {
      kullaniciMenu.classList.remove("acik");
    });
  </script>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>