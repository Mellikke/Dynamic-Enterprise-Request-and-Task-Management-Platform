@{
    ViewData["Title"] = "Admin Girişi";
    Layout = "_AuthLayout";
}

<a href="/" class="geri">&larr; Rol seçimine dön</a>

<div class="baslik">
  <div class="rozet">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    </svg>
  </div>
  <h1>Admin Girişi</h1>
  <p>Sistem yönetimi paneline erişmek için giriş yapın</p>
</div>

<form id="adminFormu" asp-controller="Home" asp-action="adminGiris" method="post">
  <div class="alan">
    <label for="eposta">E-posta</label>
    <input type="email" id="eposta" name="Email" placeholder="admin@sirket.com" autocomplete="username">
  </div>

  <div class="alan">
    <label for="sifre">Şifre</label>
    <input type="password" id="sifre" name="Password" placeholder="••••••••" autocomplete="current-password">
  </div>

  <div class="satir">
    <label><input type="checkbox" id="hatirla" name="RememberMe" value="true"> Beni unutma</label>
  </div>

  <p class="hata" id="hata"></p>

  <button type="submit" class="giris-btn" id="girisBtn">Giriş Yap</button>
</form>

@section Scripts {
  <script>
    const form  = document.getElementById("adminFormu");
    const btn   = document.getElementById("girisBtn");
    const hata  = document.getElementById("hata");

    document.getElementById("eposta").focus();

    form.addEventListener("submit", function (e) {
      const eposta = document.getElementById("eposta").value.trim();
      const sifre  = document.getElementById("sifre").value;

      if (!eposta || !sifre) {
        e.preventDefault();
        return hataGoster("E-posta ve şifre boş bırakılamaz.");
      }
      if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(eposta)) {
        e.preventDefault();
        return hataGoster("Geçerli bir e-posta adresi girin.");
      }

      hata.classList.remove("goster");

      // Controller'da [HttpPost] AdminGiris yazılınca bu 3 satırı silin.
      e.preventDefault();
      alert("Admin girişi formu hazır. Sunucu doğrulaması henüz bağlanmadı.");
      return;

      btn.disabled = true;
      btn.textContent = "Giriş yapılıyor...";
    });

    function hataGoster(mesaj) {
      hata.textContent = mesaj;
      hata.classList.add("goster");
    }
  </script>
}